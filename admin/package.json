{
  "name": "@modelry/admin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "npm run check",
    "api:types": "openapi-typescript ../docs/contracts/openapi.yaml -o src/api/schema.ts",
    "browser:acceptance": "node ./e2e/run-acceptance.mjs",
    "browser:smoke": "node ./e2e/run-acceptance.mjs e2e/foundation.spec.ts",
    "browser:data": "node ./e2e/run-acceptance.mjs e2e/data-workspace.spec.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.2",
    "antd": "^6.6.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9"
  }
}
