        "returns": "Promise<Collection>"
      },
      "classification": "backend-api",
      "httpMethod": "GET",
      "path": "/_modelry/api/v1/collections/{collectionId}",
      "requestDto": "CollectionPath",
      "responseDto": "Collection",
      "capability": ["model:read"],
      "policy": "Control Plane Capability Scope only",
      "concurrency": "none",
      "notes": "collectionId 是 stable opaque ID；name 只作为展示和 Data Plane 路由别名。"
