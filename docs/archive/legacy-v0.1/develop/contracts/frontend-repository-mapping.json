      "path": "/_modelry/api/v1/collections",
      "requestDto": "CollectionListQuery",
      "responseDto": "Collection[]",
      "capability": ["model:read"],
      "policy": "Control Plane Capability Scope only",
      "concurrency": "none",
      "notes": "读取 Backend Model 的 Collection 视图。"
    },
    {
      "repository": "CollectionRepository",
      "method": "getCollection",
      "signature": {
        "parameters": [
          { "name": "collectionId", "type": "string", "optional": false }
