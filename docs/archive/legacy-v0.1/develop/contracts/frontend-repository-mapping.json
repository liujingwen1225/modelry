      "responseDto": "ChangeSet",
      "capability": ["changeset:propose"],
      "policy": "仅 Draft/Ready 可取消",
      "concurrency": "state transition guarded",
      "notes": "Applied、Cancelled、Applying ChangeSet 不能再次取消。"
    },
