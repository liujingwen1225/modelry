      "responseDto": "ApplyAttempt[]",
      "capability": ["model:read"],
      "policy": "Control Plane Capability Scope only",
      "concurrency": "none",
      "notes": "changeSetId 是可选过滤条件；Failed 只出现在 ApplyAttempt。"
    },
    {
      "repository": "ChangeSetRepository",
      "method": "applyChangeSet",
      "signature": {
        "parameters": [
          { "name": "changeSetId", "type": "string", "optional": false },
          { "name": "confirmationPrincipalId", "type": "string", "optional": true }
        ],
        "returns": "Promise<ApplyAttempt>"
      },
      "classification": "backend-api",
      "httpMethod": "POST",
