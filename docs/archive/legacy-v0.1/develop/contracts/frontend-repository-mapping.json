      "classification": "presentation-only",
      "httpMethod": null,
      "path": null,
      "requestDto": null,
      "responseDto": null,
      "capability": [],
      "policy": "not a URL-based public delete endpoint",
      "concurrency": "post-commit durable work",
      "notes": "文件对象删除由 Record/File 引用变化产生 durable file.object.delete；前端 URL helper 不得成为 Backend API。"
