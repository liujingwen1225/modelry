        ],
        "returns": "Promise<RelationOption[]>"
      },
      "classification": "derived-read",
      "httpMethod": "GET",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records",
      "requestDto": "RelationOptionsQuery",
      "responseDto": "RelationOption[]",
      "capability": ["data:inspect"],
      "policy": "Administrative Data Access；不伪装 auth.id",
      "concurrency": "none",
      "notes": "不新增 relation-options endpoint；由受控 Record 查询返回 id/displayField 后在前端投影。"
    },
    {
      "repository": "RecordRepository",
      "method": "listRecords",
      "signature": {
        "parameters": [
          { "name": "query", "type": "RecordQuery", "optional": false }
        ],
        "returns": "Promise<RecordListResult>"
      },
      "classification": "backend-api",
      "httpMethod": "GET",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records",
      "requestDto": "AdministrativeRecordListQuery",
      "responseDto": "RecordListResponse",
      "capability": ["data:inspect"],
      "policy": "Administrative Data Access；不运行 Record Policy",
      "concurrency": "none",
      "notes": "Frontend Admin Repository 使用 Control Plane 管理数据投影；Application 使用对应 Data Plane 路由并运行 Record Policy。"
    },
    {
      "repository": "RecordRepository",
      "method": "getRecord",
      "signature": {
        "parameters": [
          { "name": "collectionId", "type": "string", "optional": false },
          { "name": "recordId", "type": "string", "optional": false }
        ],
        "returns": "Promise<ModelRecord>"
      },
      "classification": "backend-api",
      "httpMethod": "GET",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records/{recordId}",
      "requestDto": "AdministrativeRecordPath",
      "responseDto": "Record",
      "capability": ["data:inspect"],
      "policy": "Administrative Data Access；不运行 Record Policy",
      "concurrency": "none",
      "notes": "Application Data Plane 对应 GET /api/v1/collections/{collection}/records/{id}，无权资源采用非泄漏 NOT_FOUND。"
    },
    {
      "repository": "RecordRepository",
      "method": "createRecord",
      "signature": {
        "parameters": [
          { "name": "collectionId", "type": "string", "optional": false },
          { "name": "values", "type": "Record<string, RecordInputValue>", "optional": false }
        ],
        "returns": "Promise<ModelRecord>"
      },
      "classification": "backend-api",
      "httpMethod": "POST",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records",
      "requestDto": "RecordMutationRequest",
      "responseDto": "Record",
      "capability": ["data:mutate"],
      "policy": "Administrative Data Access；不运行 Record Policy；Application 路径运行 create Policy",
      "concurrency": "none",
      "notes": "File Field 新绑定只能使用 uploadSessionId；事务成功后才将 Upload Session 标记 committed。"
    },
    {
      "repository": "RecordRepository",
      "method": "updateRecord",
      "signature": {
        "parameters": [
          { "name": "collectionId", "type": "string", "optional": false },
          { "name": "recordId", "type": "string", "optional": false },
          { "name": "values", "type": "Record<string, RecordInputValue>", "optional": false },
          { "name": "expectedVersion", "type": "number", "optional": true }
        ],
        "returns": "Promise<ModelRecord>"
      },
      "classification": "backend-api",
      "httpMethod": "PATCH",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records/{recordId}",
      "requestDto": "RecordMutationRequest",
      "responseDto": "Record",
      "capability": ["data:mutate"],
      "policy": "Administrative Data Access；不运行 Record Policy；Application 路径运行 before/after update Policy",
      "concurrency": "If-Match required when optimisticLock=true",
      "notes": "expectedVersion 只映射为 If-Match；不能同时使用第二套 version request field。"
    },
    {
      "repository": "RecordRepository",
      "method": "deleteRecord",
      "signature": {
        "parameters": [
          { "name": "collectionId", "type": "string", "optional": false },
          { "name": "recordId", "type": "string", "optional": false },
          { "name": "expectedVersion", "type": "number", "optional": true }
        ],
        "returns": "Promise<void>"
      },
      "classification": "backend-api",
      "httpMethod": "DELETE",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/records/{recordId}",
      "requestDto": "no body",
      "responseDto": "204 No Content",
      "capability": ["data:mutate"],
      "policy": "Administrative Data Access；不运行 Record Policy；Application 路径运行 delete Policy",
      "concurrency": "If-Match required when optimisticLock=true; optional otherwise",
      "notes": "softDelete=true 时只改变可观察状态；Admin 查询可显式 inspect deleted Record。"
    },
    {
