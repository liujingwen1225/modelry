    },
    {
      "repository": "BulkMutationRepository",
      "method": "executeBulkMutation",
      "signature": {
        "parameters": [
          { "name": "request", "type": "BulkMutationRequest", "optional": false }
        ],
        "returns": "Promise<BulkMutationResult>"
      },
      "classification": "backend-api",
      "httpMethod": "POST",
      "path": "/_modelry/api/v1/data/collections/{collectionId}/bulk",
      "requestDto": "BulkMutationExecuteRequest",
      "responseDto": "BulkMutationResult",
      "capability": ["data:mutate"],
