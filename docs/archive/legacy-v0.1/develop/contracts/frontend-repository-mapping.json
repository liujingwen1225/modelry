    },
    {
      "repository": "StorageRepository",
      "method": "getUploadSession",
      "signature": {
        "parameters": [
          { "name": "sessionId", "type": "string", "optional": false }
        ],
        "returns": "Promise<UploadSession>"
      },
      "classification": "backend-api",
      "httpMethod": "GET",
