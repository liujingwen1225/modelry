      "repository": "ChangeSetRepository",
      "method": "listApplyAttempts",
      "signature": {
        "parameters": [
          { "name": "changeSetId", "type": "string", "optional": true }
        ],
        "returns": "Promise<ApplyAttempt[]>"
      },
      "classification": "backend-api",
      "httpMethod": "GET",
      "path": "/_modelry/api/v1/apply-attempts",
