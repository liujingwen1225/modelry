      "requestDto": "CollectionCreateRequest -> ChangeSetProposalRequest",
      "responseDto": "ChangeSet",
      "capability": ["model:write", "changeset:propose"],
      "policy": "ChangeSet content is validated; no Record Policy",
      "concurrency": "baseModelHash reserved by server",
      "notes": "Frontend input 只表达 collection.create；Backend 负责生成 Diff、Risk、Preconditions 和 Ready ChangeSet。"
    },
    {
      "repository": "CollectionRepository",
      "method": "getRelationOptions",
