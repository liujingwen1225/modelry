      "responseDto": "ApplyAttempt",
      "capability": ["changeset:apply"],
      "policy": "重新校验当前 Risk/Preconditions/Confirmation",
      "concurrency": "复用适用的 reserved ApplyPlan；base hash 失效则 CHANGESET_STALE",
